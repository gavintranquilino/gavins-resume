{
  "latex-workshop.latex.outDir": "%DIR%/out",
  "latex-workshop.latex.auxDir": "%DIR%/out",
  "latex-workshop.latex.recipe.default": "latexmk (XeLaTeX)",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk (XeLaTeX)",
      "command": "latexmk",
      "args": [
        "-xelatex",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-outdir=%OUTDIR%",
        "-auxdir=%OUTDIR%",
        "%DOC%"
      ]
    },
    {
      "name": "Resume: general",
      "command": "make",
      "args": [
        "-C",
        "%DIR%",
        "pdf",
        "ROLE=general"
      ]
    },
